APP_NAME=BookifyTesting
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
SCOUT_DRIVER=null
SCOUT_QUEUE=false

VNP_TMN_CODE=TESTVNPAY
VNP_HASH_SECRET=test_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL="${APP_URL}/api/v1/payments/vnpay/return"
VNP_PAYMENT_TTL_HOURS=12

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=15
REDIS_CACHE_DB=15
REDIS_PREFIX=bookify_testing_

REGISTRATION_CACHE_STORE=array
AI_CHAT_HISTORY_STORE=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_CHAT_TIMEOUT_SECONDS=15
AI_CHAT_RETRY_TIMES=2
AI_CHAT_RETRY_SLEEP_MS=200

AI_RAG_INDEX_NAME=books
AI_RAG_EMBEDDER_NAME=gemini_embedding_2_768
AI_RAG_EMBEDDING_DIMENSIONS=768
AI_RAG_TOP_K=5
AI_RAG_MIN_SCORE=0.80
AI_RAG_RRF_MIN_SCORE=0.016
AI_RAG_RRF_K=60
AI_RAG_KEYWORD_TOP1_MIN_SCORE=0.70
AI_RAG_HYBRID_SEMANTIC_RATIO=0.6
AI_RAG_SYNC_BATCH_SIZE=20
AI_RAG_SYNC_BATCH_SLEEP_MS=0
AI_RAG_EMBED_BATCH_SIZE=25
AI_RAG_SYNC_STOP_ON_429=true
AI_RAG_EMBEDDING_TEXT_MAX_DESCRIPTION_CHARS=3000
AI_RAG_SYNC_PENDING_KEY=ai:rag:sync:pending_book_ids:test
AI_RAG_SYNC_QUEUE=ai-rag-sync
AI_RAG_SYNC_JOB_UNIQUE_FOR=3600
AI_RAG_SYNC_MAX_RETRIES=5
AI_RAG_SYNC_FAILED_RETRY_DELAY_SECONDS=0
AI_RAG_SYNC_RETRY_COUNTS_KEY=ai:rag:sync:retry_counts:test
AI_RAG_SYNC_DEAD_LETTER_KEY=ai:rag:sync:dead_letter_book_ids:test
AI_RAG_SYNC_PROCESSING_CLAIMS_KEY=ai:rag:sync:processing_claims:test
AI_RAG_SYNC_PROCESSING_CLAIM_TTL_SECONDS=900

AI_CHAT_HISTORY_TTL_SECONDS=86400
AI_CHAT_HISTORY_MAX_TURNS=10
AI_CHAT_MIN_QUESTION_LENGTH=2
AI_CHAT_MAX_QUESTION_LENGTH=1000
AI_CHAT_STUB_MESSAGE="Chatbot đang được triển khai. Vui lòng quay lại sau."
AI_CHAT_FALLBACK_MESSAGE="Chatbot đang bận, vui lòng thử lại sau."
AI_CHAT_NO_CONTEXT_MESSAGE="Tôi chưa tìm thấy thông tin phù hợp trong dữ liệu hiện có của Bookify."
AI_CHAT_RATE_LIMIT_GUEST=20
AI_CHAT_RATE_LIMIT_MEMBER=60
