APP_NAME=Bookify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://book_ecommerce.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPA (Sanctum cookie auth + CORS). Comma-separated hosts without scheme for Sanctum.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1,book_ecommerce.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis requires ext-redis; use predis on dev machines without the extension
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OTP / register_token storage (uses Laravel cache; set to redis when CACHE_STORE=redis)
REGISTRATION_CACHE_STORE=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrative divisions API
TINH_THANH_PHO_BASE_URL=https://tinhthanhpho.com/api/v1
TINH_THANH_PHO_API_KEY=
TINH_THANH_PHO_TIMEOUT=10
TINH_THANH_PHO_CACHE_TTL=604800
TINH_THANH_PHO_STALE_TTL=2592000
TINH_THANH_PHO_CACHE_VERSION=v2025

# Guest cart
GUEST_CART_COOKIE=bookify_guest_cart
GUEST_CART_TOKEN_TTL_DAYS=14

# VNPay
VNP_TMN_CODE=mã_của_bạn
VNP_HASH_SECRET=chuỗi_bí_mật_của_bạn
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL="${APP_URL}/api/v1/payments/vnpay/return"
VNP_PAYMENT_TTL_HOURS=12

# Order
ORDER_COD_PROCESSING_GRACE_MINUTES=30

# Low stock
LOW_STOCK_THRESHOLD=5
LOW_STOCK_IMMEDIATE_NOTIFICATIONS=true
LOW_STOCK_NOTIFICATION_PREVIEW_LIMIT=5

# Refund
REFUND_MANUAL_DEADLINE_DAYS=15
VIETQR_BANKS_URL=https://api.vietqr.io/v2/banks
REFUND_BANKS_CACHE_TTL_SECONDS=86400

# Invoice
INVOICE_SELLER_NAME="CÔNG TY TNHH MỘT THÀNH VIÊN"
INVOICE_SELLER_ADDRESS="334 Điện Biên Phủ, Quận Hai Bà Trưng, Hà Nội"
INVOICE_SELLER_PHONE="0373730558"

# Meilisearch
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=your_meilisearch_host
MEILISEARCH_KEY=your_meilisearch_key

# AI / RAG chatbot (Gemini + Meilisearch hybrid)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_CHAT_TIMEOUT_SECONDS=15
AI_CHAT_RETRY_TIMES=2
AI_CHAT_RETRY_SLEEP_MS=200
AI_RAG_INDEX_NAME=books
AI_RAG_EMBEDDER_NAME=gemini_embedding_2_768
AI_RAG_EMBEDDING_DIMENSIONS=768
AI_RAG_TOP_K=5
AI_RAG_MIN_SCORE=0.80
AI_RAG_RRF_MIN_SCORE=0.016
AI_RAG_RRF_K=60
AI_RAG_KEYWORD_TOP1_MIN_SCORE=0.70
AI_RAG_HYBRID_SEMANTIC_RATIO=0.6
AI_RAG_SYNC_BATCH_SIZE=20
AI_RAG_SYNC_BATCH_SLEEP_MS=500
AI_RAG_EMBED_BATCH_SIZE=25
AI_RAG_SYNC_STOP_ON_429=true
AI_RAG_EMBEDDING_TEXT_MAX_DESCRIPTION_CHARS=3000
AI_RAG_SYNC_PENDING_KEY=ai:rag:sync:pending_book_ids
AI_RAG_SYNC_QUEUE=ai-rag-sync
AI_RAG_SYNC_JOB_UNIQUE_FOR=3600
AI_RAG_SYNC_MAX_RETRIES=5
AI_RAG_SYNC_FAILED_RETRY_DELAY_SECONDS=60
AI_RAG_SYNC_PROCESSING_CLAIM_TTL_SECONDS=900
AI_CHAT_HISTORY_TTL_SECONDS=86400
AI_CHAT_HISTORY_MAX_TURNS=10
AI_CHAT_HISTORY_STORE=redis
AI_CHAT_MIN_QUESTION_LENGTH=2
AI_CHAT_MAX_QUESTION_LENGTH=1000
AI_CHAT_STUB_MESSAGE="Chatbot dang duoc trien khai. Vui long quay lai sau."
AI_CHAT_FALLBACK_MESSAGE="Chatbot dang ban, vui long thu lai sau."
AI_CHAT_NO_CONTEXT_MESSAGE="Tôi chưa tìm thấy thông tin phù hợp trong dữ liệu hiện có của Bookify."
AI_CHAT_RATE_LIMIT_GUEST=20
AI_CHAT_RATE_LIMIT_MEMBER=60
AI_CHAT_FEEDBACK_RATE_LIMIT_GUEST=30
AI_CHAT_FEEDBACK_RATE_LIMIT_MEMBER=60
AI_CHAT_EXACT_BOOK_MAX_CANDIDATES=3
AI_CHAT_LOG_RETENTION_DAYS=90
AI_CHAT_PRUNE_CHUNK_SIZE=500