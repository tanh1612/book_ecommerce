APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://book_ecommerce.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis requires ext-redis; use predis on dev machines without the extension
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OTP / register_token storage (uses Laravel cache; set to redis when CACHE_STORE=redis)
REGISTRATION_CACHE_STORE=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrative divisions API (https://tinhthanhpho.com/api-docs)
TINH_THANH_PHO_BASE_URL=https://tinhthanhpho.com/api/v1
TINH_THANH_PHO_API_KEY=
TINH_THANH_PHO_TIMEOUT=10
TINH_THANH_PHO_CACHE_TTL=604800
TINH_THANH_PHO_CACHE_VERSION=v2025

VNP_TMN_CODE=mã_của_bạn
VNP_HASH_SECRET=chuỗi_bí_mật_của_bạn
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Backend URL VNPay redirects to (e.g. ngrok): must match route GET /api/v1/payments/vnpay/return
VNP_RETURN_URL="${APP_URL}/api/v1/payments/vnpay/return"
VNP_PAYMENT_TTL_HOURS=12

# Phút chờ sau khi đơn COD vào "Đã xác nhận" trước khi admin chuyển sang "Đang xử lý" (mặc định 30)
ORDER_COD_PROCESSING_GRACE_MINUTES=30

# Ngưỡng tồn khả dụng (quantity - reserved_quantity) để coi là sắp hết hàng (mặc định 5)
LOW_STOCK_THRESHOLD=5
# Gửi thông báo Filament ngay khi tồn chuyển sang sắp hết / hết hàng (mặc định true)
LOW_STOCK_IMMEDIATE_NOTIFICATIONS=true
# Số dòng tồn kho hiển thị trong thông báo admin hằng ngày (mặc định 5)
LOW_STOCK_NOTIFICATION_PREVIEW_LIMIT=5

# Hotline hiển thị khi đơn VNPay chờ hoàn tiền thủ công (giao hàng thất bại)
REFUND_SUPPORT_HOTLINE=
# Số ngày khách phải liên hệ cung cấp thông tin hoàn tiền (mặc định 15)
REFUND_MANUAL_DEADLINE_DAYS=15
# Danh sách ngân hàng hoàn tiền (VietQR public API, cache 24h)
VIETQR_BANKS_URL=https://api.vietqr.io/v2/banks
REFUND_BANKS_CACHE_TTL_SECONDS=86400

INVOICE_SELLER_NAME="CÔNG TY TNHH MỘT THÀNH VIÊN"
INVOICE_SELLER_ADDRESS="334 Điện Biên Phủ, Quận Hai Bà Trưng, Hà Nội"
INVOICE_SELLER_PHONE="0373730558"